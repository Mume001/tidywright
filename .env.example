# Copy to .env.local and fill in. Never commit a filled file.
# See docs/20-infrastructure.md for where each value comes from.

# --- Supabase (B1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Public hosts ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_EMBED_HOST=http://localhost:3000

# --- Mock API (F1 only) ---
# /api/mock/* answers in development and returns 404 in production. Set this to
# any value to turn it back on, for a staging box or a demo. Never in prod.
TW_ALLOW_MOCKS=

# --- Cloudflare Turnstile (B4) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Model providers (B3) ---
TW_MODEL_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TW_MODEL_DAILY_BUDGET_USD=25

# --- Email (B5) ---
RESEND_API_KEY=
TW_MAIL_FROM_HOST=mail.siteauditserver.com

# --- Stripe (phase 2) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Observability (B4) ---
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=

# --- Web Bot Auth (before B2) ---
# Ed25519 private key, PKCS#8 PEM, from `pnpm bot:keys`. Signs our outgoing
# requests and the key directory at /.well-known/http-message-signatures-directory.
# Same class of secret as TW_CREDENTIALS_KEK: env only, never the repo, never the
# database. docs/38-bot-verification.md.
TW_BOT_SIGNING_KEY=

# Set only when the marketing site is ready (F3). Until then tidywright.com
# serves the bot page and the key directory and 404s everything else.
TW_MARKETING_LIVE=

# --- Connector secrets (phase 3) ---
TW_CREDENTIALS_KEK=
